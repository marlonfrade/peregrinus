# peregrinus: copy to .env (git-ignored) and fill in.
# Port map: ../PORTS.md
DEFAULT_LANGUAGE=br
# Keep place search on OpenStreetMap; do not call places.liketrek.com.
TREK_PLACES_ENABLED=false
# Required. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Host port for docker-compose.peregrinus.yml
# Domus: 3200 — never 3000 (Nummus owns that port).
PEREGRINUS_PORT=3200
# Docker UI URL (compose sets this). npm run uses server/.env → :5173.
APP_URL=http://localhost:3200
ALLOWED_ORIGINS=http://localhost:3200,http://localhost:5173
# Plain-HTTP local run only (http://localhost): uncomment so the session cookie
# is not dropped. Leave it commented behind HTTPS (VPS / reverse proxy).
COOKIE_SECURE=false
# First-boot only (ignored once any user exists). Reset with server/reset-admin.js.
ADMIN_EMAIL=
ADMIN_PASSWORD=
